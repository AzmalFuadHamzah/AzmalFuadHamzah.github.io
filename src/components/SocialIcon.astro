---
interface Props {
  kind:
    | "email"
    | "github"
    | "linkedin"
    | "facebook"
    | "instagram"
    | "whatsapp"
    | "download";
}

const { kind } = Astro.props;
---

<svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
  {kind === "email" && (
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m4 7 8 6 8-6" />
    </g>
  )}
  {kind === "github" && (
    <path
      fill="currentColor"
      d="M12 1.8a10.2 10.2 0 0 0-3.23 19.87c.51.1.7-.22.7-.5v-1.76c-2.85.62-3.45-1.2-3.45-1.2-.46-1.18-1.13-1.5-1.13-1.5-.93-.63.07-.62.07-.62 1.03.07 1.57 1.06 1.57 1.06.91 1.56 2.4 1.11 2.98.85.09-.66.36-1.1.65-1.35-2.28-.26-4.68-1.14-4.68-5.06 0-1.12.4-2.04 1.06-2.77-.1-.26-.46-1.31.1-2.73 0 0 .87-.28 2.84 1.06a9.9 9.9 0 0 1 5.18 0c1.98-1.34 2.84-1.06 2.84-1.06.56 1.42.21 2.47.11 2.73.66.73 1.05 1.65 1.05 2.77 0 3.93-2.4 4.8-4.69 5.05.37.32.7.95.7 1.93v2.88c0 .28.19.61.7.5A10.2 10.2 0 0 0 12 1.8Z"
    />
  )}
  {kind === "linkedin" && (
    <path
      fill="currentColor"
      d="M6.5 8.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM5 10h3v9H5v-9Zm5 0h2.9v1.23h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.61 2 3.61 4.6V19h-3v-4.2c0-1-.02-2.28-1.39-2.28-1.4 0-1.61 1.09-1.61 2.21V19h-3v-9Z"
    />
  )}
  {kind === "facebook" && (
    <path
      fill="currentColor"
      d="M13.45 21v-8.2h2.76l.41-3.2h-3.17V7.55c0-.93.26-1.56 1.59-1.56h1.7V3.12c-.3-.04-1.34-.12-2.55-.12-2.52 0-4.25 1.54-4.25 4.38V9.6H7.08v3.2h2.86V21h3.51Z"
    />
  )}
  {kind === "instagram" && (
    <g fill="none" stroke="currentColor" stroke-width="1.8">
      <rect x="3.25" y="3.25" width="17.5" height="17.5" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.6" cy="6.6" r="1" fill="currentColor" stroke="none" />
    </g>
  )}
  {kind === "whatsapp" && (
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7">
      <path d="M20.2 11.7a8.2 8.2 0 0 1-12.1 7.2L3.8 20l1.1-4.1a8.2 8.2 0 1 1 15.3-4.2Z" />
      <path d="M8.4 7.9c.2-.4.4-.5.7-.5h.5c.2 0 .4.1.5.4l.7 1.5c.1.2.1.4-.1.6l-.5.6c-.2.2-.2.4 0 .6.6 1 1.4 1.7 2.4 2.2.2.1.4.1.6-.1l.6-.7c.2-.2.4-.2.6-.1l1.5.7c.2.1.3.3.3.5-.1.6-.5 1.2-1.1 1.4-.6.2-1.3.1-2-.2-1.2-.5-2.4-1.4-3.3-2.5-.8-.9-1.2-1.8-1.2-2.6 0-.7.3-1.3.8-1.8Z" />
    </g>
  )}
  {kind === "download" && (
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
      <path d="M12 3v11m0 0 4-4m-4 4-4-4" />
      <path d="M5 16v4h14v-4" />
    </g>
  )}
</svg>
