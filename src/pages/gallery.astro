---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const pages = await getCollection("gallery");
const page = pages[0];
if (!page) throw new Error("Add a Markdown page under src/content/gallery.");
const { Content } = await render(page);
---

<BaseLayout title="Gallery | Azmal Fuad Hamzah" description={page.data.summary}>
  <article class="container content-page">
    <h1>{page.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
